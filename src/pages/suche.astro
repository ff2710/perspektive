---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../utils/url';
---

<BaseLayout title="Suche" description="Volltextsuche in allen Beiträgen von Fidels Perspektive." noindex search={false}>
	<h1 class="page-title">Suche</h1>

	<form class="search" role="search" data-search data-pagefind={url('/pagefind/pagefind.js')}>
		<label class="visually-hidden" for="suchbegriff">Suchbegriff</label>
		<input id="suchbegriff" name="q" type="search" autocomplete="off" autofocus placeholder="In allen Beiträgen suchen" />
	</form>

	<p class="meta search__status" role="status" data-search-status></p>
	<ol class="post-list search__results" data-search-results></ol>
	<noscript><p class="empty">Für die Suche wird JavaScript benötigt.</p></noscript>

	<script>
		import '../scripts/search.ts';
	</script>
</BaseLayout>
