---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pills from '../../components/Pills.astro';
import PostMeta from '../../components/PostMeta.astro';
import Toc from '../../components/Toc.astro';
import { formatDate, getPosts, readingMinutes } from '../../utils/posts';
import { url } from '../../utils/url';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: { post, others: posts.filter((_, j) => j !== i).slice(0, 3) },
	}));
}

const { post, others } = Astro.props;
const allPosts = await getPosts();
// Titel und Datum für die Hover-Vorschau interner Links (Schlüssel: Pfad mit Schrägstrich am Ende)
const linkIndex = Object.fromEntries([
	...allPosts.map((p) => [url(`/beitraege/${p.id}/`), { title: p.data.title, date: formatDate(p.data.pubDate) }]),
	[url('/ueber-mich/'), { title: 'Über mich' }],
	[url('/themen/'), { title: 'Themen' }],
]);
const linkIndexJson = JSON.stringify(linkIndex).replace(/</g, '\\u003c');
const { Content, headings } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description} italic type="article" publishedTime={post.data.pubDate} tags={post.data.tags}>
	<div class="progress" aria-hidden="true"></div>
	<div class="article-wrap">
		<Toc headings={headings} />
		<article class="article" data-pagefind-body data-pagefind-meta={`date:${post.data.pubDate.toISOString().slice(0, 10)}`}>
			<header class="article__head">
				<h1 class="page-title">{post.data.title}</h1>
				<p class="dek">{post.data.description}</p>
				<PostMeta post={post} />
				<Pills tags={post.data.tags} />
			</header>

			<div class="prose">
				<Content />
			</div>

			<footer class="article__foot" data-pagefind-ignore>
				<Pills tags={post.data.tags} />

				<div class="share" data-share hidden>
					<button type="button" class="share__button">Beitrag teilen</button>
					<span class="visually-hidden" role="status" data-share-status></span>
				</div>

				<aside class="author" aria-label="Über den Autor">
					<b>Fidel</b>
					<p>Politikwissenschaftsstudent. Ich teile hier meine Perspektive zu aktuellen politischen Themen.</p>
					<p><a href={url('/ueber-mich/')}>Mehr über mich</a></p>
				</aside>

			</footer>
		</article>
	</div>

	{
		others.length > 0 && (
			<section class="further" slot="after" aria-labelledby="weiterlesen">
				<div class="wrap">
					<h2 class="further__title" id="weiterlesen">
						Weiterlesen
					</h2>
					<ul class="further__list">
						{others.map((other) => (
							<li>
								<h3>
									<a href={url(`/beitraege/${other.id}/`)}>{other.data.title}</a>
								</h3>
								<p>{other.data.description}</p>
								<p class="meta">{readingMinutes(other)}&nbsp;Min. Lesezeit</p>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}
	<script type="application/json" id="link-index" set:html={linkIndexJson} />
	<script>
		import '../../scripts/preview.ts';
		import '../../scripts/footnotes.ts';
		import '../../scripts/toc.ts';
		import '../../scripts/share.ts';
	</script>
</BaseLayout>
