---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pills from '../../components/Pills.astro';
import PostMeta from '../../components/PostMeta.astro';
import { getPosts, readingMinutes } from '../../utils/posts';
import { url } from '../../utils/url';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: { post, others: posts.filter((_, j) => j !== i).slice(0, 3) },
	}));
}

const { post, others } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
	<article class="article">
		<header class="article__head">
			<h1 class="page-title">{post.data.title}</h1>
			<p class="dek">{post.data.description}</p>
			<PostMeta post={post} />
			<Pills tags={post.data.tags} />
		</header>

		<div class="prose">
			<Content />
		</div>

		<footer class="article__foot">
			<Pills tags={post.data.tags} />

			<aside class="author" aria-label="Über den Autor">
				<b>Fidel</b>
				<p>Politikwissenschaftsstudent. Ich teile hier meine Perspektive zu aktuellen politischen Themen.</p>
				<p><a href={url('/ueber-mich/')}>Mehr über mich</a></p>
			</aside>

			{
				others.length > 0 && (
					<section aria-labelledby="weiterlesen">
						<h2 class="more__title" id="weiterlesen">
							Weiterlesen
						</h2>
						<ul class="post-list">
							{others.map((other) => (
								<li class="post-list__item">
									<h3 class="post-list__title">
										<a href={url(`/beitraege/${other.id}/`)}>{other.data.title}</a>
									</h3>
									<p class="post-list__teaser">{other.data.description}</p>
									<p class="meta">{readingMinutes(other)}&nbsp;Min. Lesezeit</p>
								</li>
							))}
						</ul>
					</section>
				)
			}
		</footer>
	</article>
</BaseLayout>
