---
import '@fontsource-variable/archivo';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '../styles/global.css';
import { url } from '../utils/url';

interface Props {
	title?: string;
	description?: string;
	home?: boolean;
	/** Open-Graph-Typ: "article" für Beiträge, sonst "website". */
	type?: 'website' | 'article';
	publishedTime?: Date;
	tags?: string[];
	/** Seiten, die nicht in Suchmaschinen sollen (z. B. die Suche selbst). */
	noindex?: boolean;
}

const siteTitle = 'Fidels Perspektive';
const siteDescription =
	'Ich bin Fidel, Politikwissenschaftsstudent, und teile hier meine Perspektive zu aktuellen politischen Themen.';
const { title, description = siteDescription, home = false, type = 'website', publishedTime, tags = [], noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${siteTitle}` : siteTitle;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const nav = [
	{ label: 'Themen', href: url('/themen/') },
	{ label: 'Über mich', href: url('/ueber-mich/') },
];
const path = Astro.url.pathname.replace(/\/?$/, '/');
const Wordmark = home ? 'h1' : 'p';
---

<!doctype html>
<html lang="de" class={home ? 'is-home' : undefined}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="author" content="Fidel" />
		<meta name="theme-color" content="#fffefb" />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonical} />
		<link rel="alternate" type="application/rss+xml" title={siteTitle} href={url('/rss.xml')} />
		<link rel="sitemap" href={url('/sitemap-index.xml')} />
		<meta property="og:site_name" content={siteTitle} />
		<meta property="og:locale" content="de_DE" />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={title ?? siteTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
		{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
		{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
		<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
		<link rel="icon" href={url('/favicon.ico')} />
		<title>{pageTitle}</title>
		<script is:inline>
			// Theme vor dem ersten Rendern setzen (kein Aufblitzen). Standard ist immer Hell.
			(function () {
				function stored() {
					try {
						return localStorage.getItem('theme');
					} catch (e) {
						return null;
					}
				}
				function apply() {
					document.documentElement.dataset.theme = stored() === 'dark' ? 'dark' : 'light';
				}
				function sync() {
					var dark = document.documentElement.dataset.theme === 'dark';
					document.querySelectorAll('[data-theme-switch]').forEach(function (button) {
						button.setAttribute('aria-checked', dark ? 'true' : 'false');
						button.hidden = false;
					});
				}
				apply();
				document.addEventListener('click', function (event) {
					if (!event.target.closest || !event.target.closest('[data-theme-switch]')) return;
					var root = document.documentElement;
					var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
					root.classList.add('theme-anim');
					root.dataset.theme = next;
					try {
						localStorage.setItem('theme', next);
					} catch (e) {}
					sync();
					setTimeout(function () {
						root.classList.remove('theme-anim');
					}, 300);
				});
				// Auch nach Seitenwechseln mit View Transitions (Astro tauscht das <html>-Element aus)
				document.addEventListener('astro:after-swap', apply);
				document.addEventListener('astro:page-load', sync);
				document.addEventListener('DOMContentLoaded', sync);
			})();
		</script>
	</head>
	<body>
		<a class="skip-link" href="#inhalt">Zum Inhalt springen</a>

		<header class="masthead wrap">
			<div class="masthead__row">
				<Wordmark class="wordmark"><a href={url('/')}>{siteTitle}</a></Wordmark>
				<nav class="nav" aria-label="Hauptnavigation">
					{
						nav.map((item) => (
							<a href={item.href} aria-current={path === item.href ? 'page' : path.startsWith(item.href) ? 'true' : undefined}>
								{item.label}
							</a>
						))
					}
					<button type="button" role="switch" aria-checked="false" aria-label="Dunkelmodus" class="theme-switch" data-theme-switch hidden>
						<span class="theme-switch__knob"></span>
					</button>
				</nav>
			</div>
			{home && <p class="tagline">{siteDescription}</p>}
			<hr class="masthead__rule" />
		</header>

		<main id="inhalt" class="wrap">
			<slot />
		</main>

		<slot name="after" />

		<footer class="footer">
			<div class="wrap footer__row">
				<span><span class="footer__name">{siteTitle}</span> · © {new Date().getFullYear()} Fidel</span>
				<span>
					<a href={url('/themen/')}>Themen</a> · <a href={url('/ueber-mich/')}>Über mich</a> · <a href={url('/rss.xml')}>RSS</a>
				</span>
			</div>
		</footer>
	</body>
</html>
