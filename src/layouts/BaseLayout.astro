---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '../styles/global.css';
// Schriften vorab laden: sonst tauscht der Browser die Ersatzschrift erst nach dem ersten Bild aus, und Text springt (Layout-Verschiebung).
import archivoFont from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import serifFont from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import serifItalicFont from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-italic.woff2?url';
import { url } from '../utils/url';

interface Props {
	title?: string;
	description?: string;
	home?: boolean;
	/** Open-Graph-Typ: "article" für Beiträge, sonst "website". */
	type?: 'website' | 'article';
	publishedTime?: Date;
	tags?: string[];
	/** Seiten, die nicht in Suchmaschinen sollen (z. B. die Suche selbst). */
	noindex?: boolean;
	/** Suchleiste im Kopf anzeigen (auf der Suchseite selbst nicht). */
	search?: boolean;
	/** Kursive Schrift vorab laden (Seiten mit kursiver Einleitung oder Teaser). */
	italic?: boolean;
}

const siteTitle = 'Perspektive';
const siteDescription =
	'Ich bin Fidel, Politikwissenschaftsstudent, und teile hier meine Perspektive zu aktuellen politischen Themen.';
const { title, description = siteDescription, home = false, type = 'website', publishedTime, tags = [], noindex = false, search = true, italic = false } = Astro.props;
const pageTitle = title ? `${title} · ${siteTitle}` : siteTitle;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Vorschaubild für geteilte Links (1200×630), liegt in public/
const ogImage = new URL(url('/og-default.png'), Astro.site).href;

const nav = [
	{ label: 'Themen', href: url('/themen/') },
	{ label: 'Über mich', href: url('/ueber-mich/') },
];
const path = Astro.url.pathname.replace(/\/?$/, '/');
const Wordmark = home ? 'h1' : 'p';
---

<!doctype html>
<html lang="de" class={home ? 'is-home' : undefined}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="preload" as="font" type="font/woff2" href={archivoFont} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={serifFont} crossorigin />
		{italic && <link rel="preload" as="font" type="font/woff2" href={serifItalicFont} crossorigin />}
		<meta name="author" content="Fidel" />
		<meta name="theme-color" content="#f6f1e7" />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonical} />
		<link rel="alternate" type="application/rss+xml" title={siteTitle} href={url('/rss.xml')} />
		<link rel="sitemap" href={url('/sitemap-index.xml')} />
		<meta property="og:site_name" content={siteTitle} />
		<meta property="og:locale" content="de_DE" />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={title ?? siteTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Perspektive, der Blog von Fidel." />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={ogImage} />
		{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
		{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
		<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
		<link rel="icon" href={url('/favicon.ico')} />
		<link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
		<title>{pageTitle}</title>
		<script is:inline>
			// Theme vor dem ersten Rendern setzen (kein Aufblitzen). Standard ist immer Hell.
			(function () {
				function stored() {
					try {
						return localStorage.getItem('theme');
					} catch (e) {
						return null;
					}
				}
				function apply() {
					document.documentElement.dataset.theme = stored() === 'dark' ? 'dark' : 'light';
				}
				function sync() {
					var dark = document.documentElement.dataset.theme === 'dark';
					document.querySelectorAll('[data-theme-switch]').forEach(function (button) {
						button.setAttribute('aria-checked', dark ? 'true' : 'false');
						button.hidden = false;
					});
				}
				apply();
				document.addEventListener('click', function (event) {
					if (!event.target.closest || !event.target.closest('[data-theme-switch]')) return;
					var root = document.documentElement;
					var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
					root.classList.add('theme-anim');
					root.dataset.theme = next;
					try {
						localStorage.setItem('theme', next);
					} catch (e) {}
					sync();
					setTimeout(function () {
						root.classList.remove('theme-anim');
					}, 300);
				});
				// Auch nach Seitenwechseln mit View Transitions (Astro tauscht das <html>-Element aus)
				document.addEventListener('astro:after-swap', apply);
				document.addEventListener('astro:page-load', sync);
				document.addEventListener('DOMContentLoaded', sync);
			})();
		</script>
	</head>
	<body>
		<a class="skip-link" href="#inhalt">Zum Inhalt springen</a>

		<header class="masthead wrap">
			<div class="masthead__row">
				<Wordmark class="wordmark">
					<a href={url('/')}>
						<span class="visually-hidden">{siteTitle}</span>
						<span class="wordmark__text" aria-hidden="true">
							<!-- Das P ist die Wortmarke: gleiche Form wie im Favicon (public/favicon.svg), Stamm und Bogen getrennt einfärbbar. -->
							<svg class="wordmark__p" viewBox="0 0 560 700" focusable="false"
								><defs><clipPath id="wmg"><polygon points="-100,100.3 215,10 88.8,450 800,450 800,750 -100,750"/></clipPath><clipPath id="wms"><polygon points="262.2,-50 800,-50 800,450 118.8,450"/></clipPath></defs><g clip-path="url(#wmg)"><path class="wordmark__stem" fill-rule="evenodd" d="M0 10H330A220 220 0 0 1 330 450H165V700H0Z M165 175H337.5A87.5 87.5 0 0 1 337.5 355H165Z"/></g><g clip-path="url(#wms)"><path class="wordmark__bowl" fill-rule="evenodd" d="M0 10H330A220 220 0 0 1 330 450H165V700H0Z M165 175H337.5A87.5 87.5 0 0 1 337.5 355H165Z"/></g></svg
							>{siteTitle.slice(1)}
						</span>
					</a>
				</Wordmark>
				<nav class="nav" aria-label="Hauptnavigation">
					{
						nav.map((item) => (
							<a href={item.href} aria-current={path === item.href ? 'page' : path.startsWith(item.href) ? 'true' : undefined}>
								{item.label}
							</a>
						))
					}
				</nav>
				<div class="masthead__tools">
					{
						search && (
							<form class="search-box" role="search" action={url('/suche/')} method="get" data-header-search data-pagefind={url('/pagefind/pagefind.js')}>
								<svg class="search-box__icon" aria-hidden="true" viewBox="0 0 24 24" focusable="false">
									<path d="M21.53 20.47l-3.66-3.66C19.195 15.24 20 13.214 20 11c0-4.97-4.03-9-9-9s-9 4.03-9 9 4.03 9 9 9c2.215 0 4.24-.804 5.808-2.13l3.66 3.66c.147.146.34.22.53.22s.385-.073.53-.22c.295-.293.295-.767.002-1.06zM3.5 11c0-4.135 3.365-7.5 7.5-7.5s7.5 3.365 7.5 7.5-3.365 7.5-7.5 7.5-7.5-3.365-7.5-7.5z" />
								</svg>
								<input
									class="search-box__input"
									type="search"
									name="q"
									placeholder="Suchen"
									aria-label="Im Blog suchen"
									autocomplete="off"
									spellcheck="false"
									enterkeyhint="search"
									role="combobox"
									aria-expanded="false"
									aria-controls="kopf-treffer"
									aria-autocomplete="list"
								/>
								<kbd class="search-box__kbd" aria-hidden="true">/</kbd>
								<ul class="search-box__results" id="kopf-treffer" role="listbox" aria-label="Suchtreffer" data-header-results hidden />
								<p class="visually-hidden" role="status" data-header-status />
							</form>
						)
					}
					<button type="button" role="switch" aria-checked="false" aria-label="Dunkelmodus" class="theme-switch" data-theme-switch hidden>
						<span class="theme-switch__thumb"></span>
						<svg class="theme-switch__icon theme-switch__icon--sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<circle cx="12" cy="12" r="4"></circle>
							<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
						</svg>
						<svg class="theme-switch__icon theme-switch__icon--moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
						</svg>
					</button>
				</div>
			</div>
			{home && <p class="tagline">{siteDescription}</p>}
			<hr class="masthead__rule" />
		</header>

		<main id="inhalt" class="wrap">
			<slot />
		</main>

		<slot name="after" />

		<script>
			import '../scripts/header-search.ts';
		</script>

		<footer class="footer">
			<div class="wrap footer__row">
				<span><span class="footer__name">{siteTitle}</span> · © {new Date().getFullYear()} Fidel</span>
				<span>
					<a href={url('/beitraege/')}>Beiträge</a> · <a href={url('/themen/')}>Themen</a> · <a href={url('/ueber-mich/')}>Über mich</a> · <a href={url('/suche/')}>Suche</a> · <a href={url('/rss.xml')}>RSS</a> · <a href={url('/impressum/')}>Impressum</a> · <a href={url('/datenschutz/')}>Datenschutz</a>
				</span>
			</div>
		</footer>
	</body>
</html>
